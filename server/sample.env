PORT=3000
MONGODB_URI=mongodb://localhost:27017/EduLaunch
NODE_ENV=development

# Email Configuration
SMTP_PASS=your_smtp_password_here
SMTP_USER=your_email@example.com

# Security
JWT_SECRET=your_very_strong_random_jwt_secret_here_at_least_32_characters

# Bunny CDN Configuration
BUNNY_STORAGE_NAME=your_bunny_storage_name
BUNNY_API_KEY=your_bunny_api_key_here

# Cache Configuration
CACHE_TTL=600